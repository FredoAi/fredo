+// MinGW-w64 does not provide `strcasestr` (a GNU/POSIX extension), so gcc 16
+// rejects the implicit declaration in API_ServeRequest. The only use is a
+// case-insensitive search for "close" in the Connection header; supply it from
+// `strncasecmp`, which `<strings.h>` does provide on Windows.
+#ifdef _WIN32
+static char *api_strcasestr(const char *haystack, const char *needle)
+{
+    size_t nlen = strlen(needle);
+
+    if (nlen == 0)
+    {
+        return (char *) haystack;
+    }
+    for (; *haystack != '\0'; haystack++)
+    {
+        if (strncasecmp(haystack, needle, nlen) == 0)
+        {
+            return (char *) haystack;
+        }
+    }
+    return NULL;
+}
+#define strcasestr api_strcasestr
+#endif
+
 
