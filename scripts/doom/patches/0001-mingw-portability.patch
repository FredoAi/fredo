+// MinGW-w64 does not provide `fmemopen` (POSIX), so gcc 16 rejects the implicit
+// declaration in API_PostSnapshotRestore. A snapshot is restored one at a time
+// and closed immediately, so on Windows stage the bytes through a `tmpfile` and
+// read them back - functionally identical to the in-memory stream the POSIX
+// build uses, without the fd exhaustion the fmemopen path was avoiding (only
+// one handle is open per restore).
+static FILE *reopen_snapshot(const char *data, size_t len)
+{
+#ifdef _WIN32
+    FILE *f = tmpfile();
+
+    if (f == NULL)
+    {
+        return NULL;
+    }
+    if (len > 0 && fwrite(data, 1, len, f) != len)
+    {
+        fclose(f);
+        return NULL;
+    }
+    rewind(f);
+    return f;
+#else
+    return fmemopen((void *) data, len, "rb");
+#endif
+}
+
