{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build VS Code Extension",
      "type": "shell",
      "command": "pnpm --filter atlas-extension build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Watch Host",
      "type": "shell",
      "command": "pnpm --filter atlas-extension watch",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "watchers"
      },
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "watching for changes",
          "endsPattern": "watching for changes"
        }
      }
    },
    {
      "label": "Watch Webview",
      "type": "shell",
      "command": "pnpm --filter atlas-extension watch:webview",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "watchers"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "built in"
        }
      }
    },
    {
      "label": "Watch VS Code Extension",
      "type": "shell",
      "command": "pnpm --filter atlas-extension build:webview && pnpm --filter atlas-extension watch",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "^\\s+(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "watching for changes",
          "endsPattern": "watching for changes"
        }
      }
    }
  ]
}
