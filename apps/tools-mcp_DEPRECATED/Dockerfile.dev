# Development Dockerfile for Atlas application
FROM node:18-alpine AS development

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    postgresql-client \
    && rm -rf /var/cache/apk/*

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install

# Copy source code
COPY . .

# Create logs directory
RUN mkdir -p /app/logs

# Expose development port
EXPOSE 3000

# Health check for development
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Default command for development (with ts-node-dev for hot reload)
CMD ["npm", "run", "dev"]

# Labels for container metadata
LABEL maintainer="Atlas Development Team"
LABEL version="1.0.0-dev"
LABEL description="Atlas - AI Tooling Framework (Development)"
LABEL org.opencontainers.image.source="https://github.com/Atlas/Atlas"