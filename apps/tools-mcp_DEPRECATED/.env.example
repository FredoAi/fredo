# Azure DevOps Configuration
AZDO_PAT=your_personal_access_token_here

# Jira Configuration (on-prem / Jira Data Center or Cloud)
# Set USE_MOCK_JIRA=false and provide credentials to connect to your Jira instance.
# Basic Auth uses email + API token (generate at: Jira → Profile → Security → API tokens).
JIRA_BASE_URL=https://jira.yourcompany.com
JIRA_EMAIL=user@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token_here
USE_MOCK_JIRA=true

# Optimizely Configuration
# OPTIMIZELY_SDK_KEY is your bearer token for the Feature Experimentation Flags REST API.
# Find it at: Optimizely → Settings → Environments → select environment → copy SDK Key
OPTIMIZELY_SDK_KEY=your_optimizely_sdk_key_here
OPTIMIZELY_PROJECT_ID=your_optimizely_project_id_here
OPTIMIZELY_BASE_URL=https://api.optimizely.com/flags/v1

# Database Configuration (Main User - Read/Write)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fredo
POSTGRES_USER=fredo_user
POSTGRES_PASSWORD=fredo_password

# Logs Query Service (Read-Only User)
LOGS_READER_DB_USER=logs_reader
LOGS_READER_DB_PASSWORD=logs_read_only_pass

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
