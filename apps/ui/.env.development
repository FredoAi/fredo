# Development environment — Vite proxy forwards /api to localhost:3000
# Backend must be started with ATLAS_SKIP_AUTH=true for these to work without a real API key.

# Leave blank to use Vite proxy (recommended for local dev)
VITE_API_URL=
VITE_MCP_URL=http://localhost:3001

# Pre-seed the API key shown in the Settings page (optional)
VITE_DEV_API_KEY=dev-skip-auth
