{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fredo",
  "version": "0.1.0",
  "identifier": "com.fredo.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @fredo/opencode-plugin build && pnpm dev:webview",
    "beforeBuildCommand": "pnpm build:webview && pnpm --filter @fredo/opencode-plugin build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fredo",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "externalBin": [],
    "resources": {
      "../../../apps/opencode-plugin/dist/index.js": "plugin/dist/index.js",
      "models/gemma-e2b-it/gemma-4-E2B-it-Q4_K_M.gguf": "models/gemma-e2b-it/gemma-4-E2B-it-Q4_K_M.gguf",
      "models/gemma-e2b-it/mmproj-F16.gguf": "models/gemma-e2b-it/mmproj-F16.gguf"
    }
  }
}
