{
  "runIdentity": {
    "commit": "<the spec-branch tip the tested tree was served at (40-hex)>",
    "capturedAt": "<ISO 8601, when the pair was captured>",
    "appId": "<the target app id, e.g. mission-monitor>",
    "injectionSpanId": "<the companion.injection span_id this was read from>"
  },
  "outline": {
    "utf8Bytes": "<the span's simplifiedHtmlBytes>",
    "nodeCount": "<the span's simplifiedHtmlNodes>",
    "truncated": "<the span's/outline's truncated flag>"
  },
  "screenshot": {
    "encodedImageTokens": "<the span's imageTokens>"
  },
  "capsInForce": {
    "maxNodes": 120,
    "maxBytes": 8192
  }
}
