                                       "model":  "xiaomi-token-plan/mimo-v2.5-pro",
                                       "prompt":  "{file:.opencode/agents/ui-ux-expert.md}",
                                       "permission":  {
                                                          "edit":  "deny",
                                                          "read":  "allow",
                                                          "glob":  "allow",
                                                          "grep":  "allow",
                                                          "chakra_ui_*":  "allow",
                                                          "reactbits_*":  "allow",
                                                          "task":  "deny",
                                                          "question":  "deny",
                                                          "doom_loop":  "deny",
                                                          "bash":  {
                                                                       "*":  "deny",
