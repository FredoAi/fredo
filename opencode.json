                                                       "doom_loop":  "deny",
                                                       "bash":  {
                                                                    "*":  "deny",
                                                                    "rust-script*":  "allow",
                                                                    "gh issue view*":  "allow",
                                                                    "gh issue list*":  "allow",
                                                                    "gh pr view*":  "allow",
                                                                    "gh pr list*":  "allow",
                                                                    "gh pr checks*":  "allow",
                                                                    "git log*":  "allow",
                                                                    "git status*":  "allow",
                                                                    "git diff*":  "allow",
                                                                    "git branch*":  "allow",
                                                                    "git show*":  "allow",
                                                                    "git fetch*":  "allow",
                                                                    "git remote*":  "allow",
