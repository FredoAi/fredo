    "mcp":  {
                "chakra-ui":  {
                                  "type":  "local",
                                  "command":  [
                                                  "npx",
                                                  "-y",
                                                  "@chakra-ui/react-mcp"
                                              ],
                                  "enabled":  true
                              },
                "reactbits":  {
                                  "type":  "local",
                                  "command":  [
                                                  "npx",
                                                  "-y",
                                                  "reactbits-dev-mcp-server"
                                              ],
                                  "enabled":  true
                              },
                "tauri":  {
                              "type":  "local",
                              "command":  [
                                              "npx",
                                              "-y",
                                              "@hypothesi/tauri-mcp-server"
                                          ],
                              "enabled":  true
                          }
            },
    "provider":  {
                     "xiaomi-token-plan":  {
                                               "npm":  "@ai-sdk/openai-compatible",
                                               "name":  "Xiaomi Token Plan",
                                               "options":  {
                                                               "baseURL":  "https://token-plan-sgp.xiaomimimo.com/v1"
                                                           },
                                               "models":  {
