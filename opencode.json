                                                       "tauri_*":  "deny",
                                                       "chakra_ui_*":  "deny",
                                                       "reactbits_*":  "deny",
                                                       "doom_loop":  "deny",
                                                       "bash":  {
                                                                    "*":  "deny",
                                                                    "rust-script*":  "allow",
                                                                    "gh issue view*":  "allow",
                                                                    "gh issue list*":  "allow",
                                                                    "gh pr view*":  "allow",
                                                                    "gh pr list*":  "allow",
                                                                    "gh pr checks*":  "allow",
