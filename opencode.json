{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-mem"],
  "instructions": [],
  "agent": {
    "planner": {
      "description": "User-facing entry point. Clarifies requirements, creates backlog issues, dispatches Architect. Resumes for final report.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:.opencode/agents/planner.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "allow"
      }
    },
    "architect": {
      "description": "Sub-agent. Creates specs (EARS + contract), branch, empty main PR. Decomposes into capsules, dispatches Coder swarm and Reviewer.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:.opencode/agents/architect.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "coder": {
      "description": "Implements scoped task capsules. Creates branch, implements, opens PR. Reads ONLY capsule.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/coder.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "reviewer": {
      "description": "Reviews PR diffs against task capsules in batch. Approves/requests changes. Dispatches Coder retries. Owns retry loop. Triggers merges.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "allow"
      }
    }
  },
  "mcp": {
    "chakra-ui": {
      "type": "local",
      "command": ["npx", "-y", "@chakra-ui/react-mcp"],
      "enabled": true
    },
    "reactbits": {
      "type": "local",
      "command": ["npx", "-y", "reactbits-dev-mcp-server"],
      "enabled": true
    },
    "tauri": {
      "type": "local",
      "command": ["npx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": true
    }
  }
}