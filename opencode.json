                                    "mode":  "subagent",
                                    "model":  "deepseek/deepseek-v4-flash",
                                    "prompt":  "{file:.opencode/agents/qa-expert.md}",
                                    "permission":  {
                                                       "edit":  "deny",
                                                       "read":  "allow",
                                                       "glob":  "allow",
                                                       "grep":  "allow",
                                                       "task":  "deny",
