{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-mem","@warp-dot-dev/opencode-warp"],
  "instructions": [".opencode/instructions/*.md"],
  "agent": {
    "fredo": {
      "description": "Architect. Creates specs, ADRs, contracts, dispatches Planner. Involved once, then out.",
      "mode": "primary",
      "model": "opencode-go/glm-5.1",
      "prompt": "{file:.opencode/agents/fredo.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "planner": {
      "description": "User-facing entry point. Clarifies requirements, creates backlog issues, dispatches Architect. Resumes for final report.",
      "mode": "subagent",
      "model": "opencode-go/qwen3.5-plus",
      "prompt": "{file:.opencode/agents/planner.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": {
          "*": "deny",
          "architect": "allow"
        }
      }
    },
    "coder": {
      "description": "Implements scoped task capsules. Creates branch, implements, opens PR. Reads ONLY capsule.",
      "mode": "subagent",
      "model": "opencode-go/minimax-m2.7",
      "prompt": "{file:.opencode/agents/coder.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "reviewer": {
      "description": "Reviews PR diffs against task capsules in batch. Approves/requests changes. Dispatches Coder retries. Owns retry loop. Triggers merges.",
      "mode": "subagent",
      "model": "opencode-go/minimax-m2.7",
      "prompt": "{file:.opencode/agents/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "allow"
      }
    }
  },
  "mcp": {
    "chakra-ui": {
      "type": "local",
      "command": ["npx", "-y", "@chakra-ui/react-mcp"],
      "enabled": true
    },
    "reactbits": {
      "type": "local",
      "command": ["npx", "-y", "reactbits-dev-mcp-server"],
      "enabled": true
    },
    "tauri": {
      "type": "local",
      "command": ["npx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": true
    }
  }
}