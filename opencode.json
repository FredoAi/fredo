{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-mem", "@warp-dot-dev/opencode-warp"],
  "instructions": [],
  "agent": {
    "planner": {
      "description": "Product Owner. Clarifies requirements, creates backlog issues, dispatches Architect. Resumes for final report.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:.opencode/agents/planner.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "architect": "allow"
        }
      }
    },
    "architect": {
      "description": "Sub-agent. Creates specs (EARS + contract), branch, empty main PR. Decomposes into capsules, dispatches Coder swarm and Reviewer.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:.opencode/agents/architect.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "coder": {
      "description": "Creates git worktree from spec branch, implements capsule, opens draft PR. Handles retry via session resume.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/coder.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "question": "deny",
        "tauri_*": "deny"
      }
    },
    "reviewer": {
      "description": "Batch reviews workspace PRs against capsules. Merges approved PRs to spec branch. Dispatches Coder retries. Opens bug issues on >4 failures. Runs automated DOM-based e2e testing via Tauri MCP. Does final coherence check on main PR.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "allow",
        "tauri_*": "allow"
      }
    }
  },
  "mcp": {
    "chakra-ui": {
      "type": "local",
      "command": ["npx", "-y", "@chakra-ui/react-mcp"],
      "enabled": true
    },
    "reactbits": {
      "type": "local",
      "command": ["npx", "-y", "reactbits-dev-mcp-server"],
      "enabled": true
    },
    "tauri": {
      "type": "local",
      "command": ["npx", "-y", "@hypothesi/tauri-mcp-server"],
      "enabled": true
    }
  }
}
