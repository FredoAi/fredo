{
    "$schema":  "https://opencode.ai/config.json",
    "plugin":  [

               ],
    "instructions":  [

                     ],
    "agent":  {
                  "product-owner":  {
                                        "description":  "Clarifies requirements, creates backlog issues, dispatches the Scrum Master. Use when a human requests work. Outputs a backlog issue.",
                                        "mode":  "primary",
                                        "model":  "deepseek/deepseek-v4-flash",
                                        "prompt":  "{file:.opencode/agents/product-owner.md}",
                                        "permission":  {
                                                           "edit":  "deny",
                                                           "read":  "allow",
                                                           "question":  "allow",
                                                           "doom_loop":  "deny",
                                                           "bash":  {
                                                                        "*":  "deny",
                                                                        "rust-script*":  "allow",
                                                                        "gh issue view*":  "allow",
                                                                        "gh issue list*":  "allow",
                                                                        "gh pr view*":  "allow",
                                                                        "gh pr list*":  "allow",
                                                                        "gh pr checks*":  "allow",
                                                                        "git log*":  "allow",
                                                                        "git status*":  "allow",
                                                                        "git diff*":  "allow",
                                                                        "git branch*":  "allow",
                                                                        "git show*":  "allow",
                                                                        "git fetch*":  "allow",
                                                                        "git remote*":  "allow",
                                                                        "* \u0026\u0026 *":  "deny",
                                                                        "* || *":  "deny",
                                                                        "* ; *":  "deny",
                                                                        "* | *":  "deny"
                                                                    },
                                                           "task":  {
                                                                        "*":  "deny",
                                                                        "scrum-master":  "allow"
                                                                    }
                                                       }
                                    },
                  "scrum-master":  {
                                       "description":  "Orchestrates the agentic pipeline. Dispatches the triage cluster, developer pool, tester, and self-improver; staffs work; reviews and merges PRs; handles blockers. Use for any orchestration or handoff.",
                                       "mode":  "primary",
                                       "model":  "deepseek/deepseek-v4-flash",
                                       "prompt":  "{file:.opencode/agents/scrum-master.md}",
                                       "permission":  {
                                                          "edit":  "deny",
                                                          "read":  "allow",
                                                          "doom_loop":  "deny",
                                                          "bash":  {
                                                                       "*":  "deny",
                                                                       "rust-script*":  "allow",
                                                                       "gh issue view*":  "allow",
                                                                       "gh issue list*":  "allow",
                                                                       "gh pr view*":  "allow",
                                                                       "gh pr list*":  "allow",
                                                                       "gh pr checks*":  "allow",
                                                                       "gh pr diff*":  "allow",
                                                                       "git log*":  "allow",
                                                                       "git status*":  "allow",
                                                                       "git diff*":  "allow",
                                                                       "git branch*":  "allow",
                                                                       "git show*":  "allow",
                                                                       "git fetch*":  "allow",
                                                                       "git remote*":  "allow",
                                                                       "* \u0026\u0026 *":  "deny",
                                                                       "* || *":  "deny",
                                                                       "* ; *":  "deny",
                                                                       "* | *":  "deny"
                                                                   },
                                                          "task":  {
                                                                       "*":  "deny",
                                                                       "software-architect":  "allow",
                                                                       "ui-ux-expert":  "allow",
                                                                       "qa-expert":  "allow",
                                                                       "developer":  "allow",
                                                                       "tester":  "allow",
                                                                       "self-improver":  "allow"
                                                                   }
                                                      }
                                   },
                  "software-architect":  {
                                             "description":  "Triage planner. Researches the codebase, builds the domain model, decomposes scope into independent sub-issues with effort estimates, and produces the technical sections of the Implementation Plan. Dispatched by the Scrum Master during Triage.",
                                             "mode":  "subagent",
                                             "model":  "deepseek/deepseek-v4-flash",
                                             "prompt":  "{file:.opencode/agents/software-architect.md}",
                                             "permission":  {
                                                                "edit":  "allow",
                                                                "read":  "allow",
                                                                "glob":  "allow",
                                                                "grep":  "allow",
                                                                "task":  "deny",
                                                                "question":  "deny",
                                                                "doom_loop":  "deny",
                                                                "bash":  {
                                                                             "*":  "deny",
                                                                             "rust-script*":  "allow",
                                                                             "gh issue view*":  "allow",
                                                                             "gh issue list*":  "allow",
                                                                             "gh pr view*":  "allow",
                                                                             "gh pr list*":  "allow",
                                                                             "gh pr checks*":  "allow",
                                                                             "git log*":  "allow",
                                                                             "git status*":  "allow",
                                                                             "git diff*":  "allow",
                                                                             "git branch*":  "allow",
                                                                             "git show*":  "allow",
                                                                             "git fetch*":  "allow",
                                                                             "git remote*":  "allow",
                                                                             "sqlite3*":  "allow",
